{
  "scope": {
    "enforce_scope": true,
    "allowed_targets": [
      "localhost",
      "127.0.0.1",
      "::1"
    ]
  },
  "safety": {
    "allow_intrusive_actions": false,
    "subprocess_timeout_seconds": 30
  },
  "logging": {
    "file": "scan.log",
    "redact_secrets": true
  },
  "distributed": {
    "enabled": false,
    "bind_host": "127.0.0.1",
    "bind_port": 9090,
    "auth_token": ""
  }
}
